# Copy to .env.local (git-ignored) or set these as CI / n8n secrets.
# Never commit real values.

# ---- Content generation (phase 1) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
CONTENT_TIMEZONE=America/Los_Angeles
CONTENT_RULES_PATH=automation/prompts/content-rules.md
# Set to 1 only for smoke tests, before the real content rules are in place.
ALLOW_PLACEHOLDER_PROMPT=

# ---- Review queue ----
# json = local file (dev). sheets = Google Sheets (what the client reviews on mobile).
QUEUE_DRIVER=json
QUEUE_JSON_PATH=automation/data/queue.json
SHEETS_SPREADSHEET_ID=
SHEETS_TAB_NAME=Content Queue
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the service account private key with literal \n escapes.
GOOGLE_PRIVATE_KEY=

# ---- Channel switches: one phase at a time ----
PUBLISH_BLOG=false      # phase 2
PUBLISH_FACEBOOK=false  # phase 3
PUBLISH_LINKEDIN=false  # phase 4

# ---- Site ----
SITE_BASE_URL=https://cga-lau.com
SITE_BLOG_PATH=/blog

# ---- Netfirms FTP (phase 2) ----
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=true
FTP_REMOTE_DIR=/blog

# ---- Facebook Page (phase 3) ----
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0

# ---- LinkedIn Company Page (phase 4) ----
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_ACCESS_TOKEN=
